{
  "name": "studioodle",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A playful drawing and coloring studio built with React and browser vector graphics.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite/config.dev.ts",
    "review": "vite --config tools/artwork-review/vite.config.ts --open /artwork-review.html",
    "build": "vite build --config vite/config.prod.ts",
    "preview": "vite preview --config vite/config.prod.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm test && npm run typecheck && npm run lint && npm run build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "android:init": "tauri android init",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test": "node --test tests/*.test.mjs",
    "brand:icons": "node scripts/build-brand-icons.mjs",
    "assets:build": "node scripts/build-stickers.mjs",
    "assets:rebuild": "node scripts/rebuild-stickers.mjs",
    "assets:audit": "node scripts/audit-stickers.mjs",
    "assets:promote": "node scripts/promote-stickers.mjs",
    "assets:catalog": "node scripts/build-asset-catalog.mjs",
    "assets:preview": "node scripts/preview-scenes.mjs",
    "books:install": "node scripts/install-coloring-book.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:review": "node scripts/test-browser.mjs --artwork-review",
    "test:library": "node scripts/test-browser.mjs --library-profile",
    "test:save": "node scripts/test-browser.mjs --save-profile",
    "test:memory": "node scripts/test-browser.mjs --memory-profile",
    "test:scene": "node scripts/test-browser.mjs --scene-profile --scene-cache-mib=64 --scene-repeat=2",
    "review:build": "vite build --config tools/artwork-review/vite.config.ts",
    "review:typecheck": "tsc --project tools/artwork-review/tsconfig.json",
    "review:preview": "vite preview --config tools/artwork-review/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "clipper2-ts": "2.0.1-18",
    "jspdf": "4.2.1",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg-pathdata": "7.2.0",
    "svg2pdf.js": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "paper": "0.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
